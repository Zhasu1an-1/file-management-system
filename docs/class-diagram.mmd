classDiagram
direction TB

class FileController
class FileAccessService {
    <<interface>>
    +create(actor, request) FileInfo
    +list(actor, search, folderId) List
    +read(actor, id) Details
    +rename(actor, id, request) FileInfo
    +delete(actor, id)
    +share(actor, id, request)
    +move(actor, id, request) FileInfo
}
class ProtectionProxy {
    -RealFileService real
    -requireFileOwner(actor, id)
}
class RealFileService {
    -FileManager manager
}

class FileManager {
    -Map~StorageType, FileStorage~ storage
    +save(file, content)
    +read(file) byte[]
    +delete(file)
}
class FileStorage {
    <<interface>>
    +type() StorageType
    +save(id, content)
    +read(id) byte[]
    +delete(id)
}
class LocalFileStorage {
    -Path directory
}
class DatabaseFileStorage {
    -JdbcTemplate jdbc
}
class StorageType {
    <<enumeration>>
    LOCAL
    DATABASE
}

class User {
    -String username
    -String displayName
    -Role role
}
class Role {
    <<enumeration>>
    OWNER
    VIEWER
}
class FileMetadata {
    -UUID id
    -String name
    -String fileType
    -int sizeBytes
    -Instant createdAt
    -StorageType storageType
    +rename(name)
    +moveTo(folder)
}
class Folder {
    -UUID id
    -String name
}
class FileShare {
    -Long id
}

FileController --> FileAccessService : injects primary service
FileAccessService <|.. ProtectionProxy
FileAccessService <|.. RealFileService
ProtectionProxy --> RealFileService : delegates authorized requests
ProtectionProxy ..> FileShare : checks via repository
ProtectionProxy ..> FileMetadata : checks via repository
RealFileService --> FileManager : manages content
FileManager *-- "1..*" FileStorage : selects by storage type
FileStorage <|.. LocalFileStorage
FileStorage <|.. DatabaseFileStorage
FileMetadata --> StorageType : records backend
FileMetadata "0..*" --> "1" User : owner
FileMetadata "0..*" --> "0..1" Folder : folder
Folder "0..*" --> "1" User : owner
FileShare "0..*" --> "1" FileMetadata : file
FileShare "0..*" --> "1" User : viewer
User --> Role : role

classDef proxy fill:#eeeaff,stroke:#5645a6,color:#1d1740
classDef bridge fill:#e7f4ff,stroke:#3475aa,color:#102b48
classDef model fill:#e9f5ed,stroke:#4f825c,color:#15351e
cssClass "FileController,FileAccessService,ProtectionProxy,RealFileService" proxy
cssClass "FileManager,FileStorage,LocalFileStorage,DatabaseFileStorage,StorageType" bridge
cssClass "User,Role,FileMetadata,Folder,FileShare" model
